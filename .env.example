# Optional. A GA4 measurement ID such as G-XXXXXXXX.
# If unset or empty, the site loads no Google tags.
PUBLIC_GA4_MEASUREMENT_ID=

# Turnstile site key (public). Required to render the contact and collaborate forms.
PUBLIC_TURNSTILE_SITE_KEY=

# Form Worker URL. Defaults to same-origin /api/forms when unset.
# Use a workers.dev URL only until the zone route is proxied.
PUBLIC_FORM_WORKER_URL=/api/forms
