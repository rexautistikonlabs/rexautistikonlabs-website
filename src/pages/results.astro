---
import Layout from '../layouts/BaseLayout.astro';
---

<Layout title="Results Dashboard | Rex Autistikōn Labs">
  <main class="results-page">
    <section class="hero">
      <h1>Results Dashboard</h1>
      <p class="subtitle">
        Personal history and interactive collective analysis of the 8-zone
        Kelvin–Voigt free-energy model — layer groups, select zones, compare metrics.
        Each stored run carries a <strong>model version</strong> stamp.
      </p>
    </section>

    <section class="panel">
      <div class="tabs">
        <button type="button" id="tabMine" class="tab active" onclick="showTab('mine')">My Results</button>
        <button type="button" id="tabCollective" class="tab" onclick="showTab('collective')">Collective Laboratory</button>
      </div>

      <div id="panelMine" class="tab-panel">
        <p id="mineStatus" class="muted">Checking sign-in…</p>
        <div id="mineList"></div>
      </div>

      <div id="panelCollective" class="tab-panel" style="display:none;">
        <p id="collectiveStatus" class="muted">Loading aggregate data…</p>
        <p id="versionNote" class="version-note" style="display:none;"></p>

        <div id="collectiveControls" class="controls" style="display:none;">
          <div class="control-block">
            <h3>Metric</h3>
            <select id="metricSelect" onchange="renderCollective()">
              <option value="mean_fidelity">Mean fidelity</option>
              <option value="mean_pi_eff">Mean π_eff</option>
              <option value="mean_free_energy_F">Mean free energy F</option>
              <option value="mean_mpa_score">Mean MPA score</option>
            </select>
          </div>
          <div class="control-block">
            <h3>Groups (layers)</h3>
            <div id="groupToggles" class="chips"></div>
          </div>
          <div class="control-block">
            <h3>Zones</h3>
            <div id="zoneToggles" class="chips"></div>
          </div>
        </div>

        <div id="summaryCards" class="summary-grid"></div>
        <div id="radarWrap" class="radar-wrap" style="display:none;">
          <svg id="radarSvg" viewBox="0 0 420 420" width="100%" height="auto"></svg>
          <div id="radarLegend" class="legend"></div>
        </div>
        <div id="regionTable"></div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .results-page { background: #f1f5f9; min-height: 80vh; }
  .hero {
    background: linear-gradient(135deg, #0f766e 0%, #134e4a 100%);
    color: #fff; text-align: center; padding: 2.75rem 1.25rem;
  }
  .hero h1 { font-size: 2rem; font-weight: 700; margin-bottom: 0.5rem; }
  .subtitle { max-width: 640px; margin: 0 auto; opacity: 0.92; line-height: 1.5; }

  .panel { max-width: 980px; margin: 0 auto; padding: 1.5rem 1.25rem 3rem; }
  .tabs { display: flex; gap: 0.5rem; margin-bottom: 1.25rem; }
  .tab {
    border: none; border-radius: 999px; padding: 0.55rem 1.15rem;
    font-weight: 600; font-size: 0.9rem; cursor: pointer;
    background: #e2e8f0; color: #334155;
  }
  .tab.active { background: #0f766e; color: #fff; }

  .muted { color: #64748b; text-align: center; padding: 2rem 1rem; }
  .error { color: #b91c1c; text-align: center; padding: 1rem; }
  .version-note {
    font-size: 0.85rem; color: #475569; background: #ecfdf5; border: 1px solid #99f6e4;
    border-radius: 8px; padding: 0.65rem 0.85rem; margin-bottom: 1rem;
  }

  .card {
    background: #fff; border: 1px solid #e2e8f0; border-radius: 12px;
    padding: 1rem 1.15rem; margin-bottom: 0.85rem;
  }
  .card h3 { margin: 0 0 0.35rem; font-size: 1rem; color: #0f172a; }
  .meta { font-size: 0.8rem; color: #64748b; margin-bottom: 0.6rem; }
  .metrics {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(110px, 1fr)); gap: 0.5rem;
  }
  .metric {
    background: #f8fafc; border-radius: 8px; padding: 0.55rem; text-align: center;
  }
  .metric .label { font-size: 0.65rem; text-transform: uppercase; color: #64748b; letter-spacing: 0.04em; }
  .metric .value { font-weight: 700; color: #0f172a; font-size: 1.05rem; }

  .controls {
    background: #fff; border: 1px solid #e2e8f0; border-radius: 12px;
    padding: 1rem 1.15rem; margin-bottom: 1rem;
    display: grid; gap: 1rem;
  }
  .control-block h3 { font-size: 0.85rem; margin: 0 0 0.45rem; color: #334155; }
  .control-block select {
    padding: 0.45rem 0.6rem; border-radius: 8px; border: 1px solid #cbd5e1;
  }
  .chips { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .chip {
    font-size: 0.78rem; padding: 0.35rem 0.65rem; border-radius: 999px;
    border: 1px solid #cbd5e1; background: #fff; cursor: pointer; color: #334155;
  }
  .chip.on { background: #0f766e; border-color: #0f766e; color: #fff; }

  .summary-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 0.75rem; margin-bottom: 1rem;
  }
  .summary-item {
    background: #fff; border: 1px solid #e2e8f0; border-radius: 10px;
    padding: 0.85rem; text-align: center;
  }
  .summary-item .label { font-size: 0.7rem; color: #64748b; text-transform: uppercase; }
  .summary-item .value { font-size: 1.25rem; font-weight: 700; color: #0f172a; }

  .radar-wrap {
    background: #fff; border: 1px solid #e2e8f0; border-radius: 12px;
    padding: 1rem; margin-bottom: 1rem;
  }
  .legend { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 0.75rem; font-size: 0.8rem; }
  .legend span { display: inline-flex; align-items: center; gap: 0.35rem; }
  .swatch { width: 12px; height: 12px; border-radius: 2px; display: inline-block; }

  table.region {
    width: 100%; border-collapse: collapse; background: #fff;
    border: 1px solid #e2e8f0; border-radius: 12px; overflow: hidden; font-size: 0.85rem;
  }
  table.region th, table.region td {
    padding: 0.55rem 0.7rem; border-bottom: 1px solid #e2e8f0; text-align: left;
  }
  table.region th { background: #f8fafc; color: #475569; font-size: 0.75rem; text-transform: uppercase; }
</style>

<script is:inline>
  const AGGREGATE_URL =
    "https://func-rex-calc-egaydydtenewdzf4.westus2-01.azurewebsites.net/api/list-aggregate-results?code=0qJh7gK1oYJUuV5grwwvJ1IUkBdMRGpmg9O-FV_KI8JqAzFuzoujFw==";
  const MY_RESULTS_BASE =
    "https://func-rex-calc-egaydydtenewdzf4.westus2-01.azurewebsites.net/api/list-my-results?code=Y1-l2FgFA4kcA-Gb3M1c4UPHumISr69gls6rtbmFD-pnAzFuKXyUwA==";

  const GROUP_COLORS = {
    neurotypical: "#0f766e",
    autistic: "#7c3aed",
    adhd: "#2563eb",
    autistic_adhd: "#db2777",
    other: "#d97706",
    prefer_not: "#64748b",
    unspecified: "#94a3b8"
  };

  let aggregateData = null;
  let activeGroups = new Set();
  let activeZones = new Set([1,2,3,4,5,6,7,8]);

  async function getSignedInEmail() {
    try {
      const res = await fetch("/.auth/me");
      const data = await res.json();
      if (data && data.clientPrincipal) {
        return data.clientPrincipal.userDetails || data.clientPrincipal.userId || null;
      }
      if (Array.isArray(data) && data.length > 0) {
        const c = data[0];
        return c.userDetails || c.user_id || c.userId || null;
      }
    } catch (e) {}
    return null;
  }

  async function fetchJson(url) {
    const res = await fetch(url);
    const text = await res.text();
    if (!text || !text.trim()) {
      throw new Error("HTTP " + res.status + " (empty response — often 401 bad key or CORS)");
    }
    let data;
    try {
      data = JSON.parse(text);
    } catch (e) {
      throw new Error("HTTP " + res.status + " — non-JSON: " + text.slice(0, 160));
    }
    if (!res.ok) {
      throw new Error((data && (data.error || data.message)) || ("HTTP " + res.status));
    }
    return data;
  }

  window.showTab = function showTab(name) {
    const mine = document.getElementById("panelMine");
    const coll = document.getElementById("panelCollective");
    const tMine = document.getElementById("tabMine");
    const tColl = document.getElementById("tabCollective");
    if (name === "mine") {
      mine.style.display = "block";
      coll.style.display = "none";
      tMine.classList.add("active");
      tColl.classList.remove("active");
    } else {
      mine.style.display = "none";
      coll.style.display = "block";
      tMine.classList.remove("active");
      tColl.classList.add("active");
      if (!aggregateData) loadCollective();
    }
  };

  async function loadMine() {
    const status = document.getElementById("mineStatus");
    const list = document.getElementById("mineList");
    const email = await getSignedInEmail();
    if (!email) {
      status.className = "muted";
      status.innerHTML = 'Please <a href="/.auth/login/aad">sign in</a> to view your results.';
      return;
    }
    status.textContent = "Loading results for " + email + "…";
    try {
      const url = MY_RESULTS_BASE + "&collaborator_id=" + encodeURIComponent(email);
      const data = await fetchJson(url);
      const items = data.items || [];
      const activeMv = data.active_model_version || "";
      if (!items.length) {
        status.className = "muted";
        status.textContent = "No stored results yet for " + email + ". Run a calculation on Data Intake." +
          (activeMv ? " (engine " + activeMv + ")" : "");
        list.innerHTML = "";
        return;
      }
      status.style.display = "none";
      list.innerHTML = items.map(item => {
        const ts = item.timestamp_utc || "";
        const mv = item.model_version || "—";
        return `<div class="card">
          <h3>${item.participant_pseudonym || "anonymous"} · session ${item.session || 1}</h3>
          <div class="meta">${ts}${item.group ? " · " + item.group : ""}${item.world_region ? " · " + item.world_region : ""} · model <strong>${mv}</strong></div>
          <div class="metrics">
            <div class="metric"><div class="label">Model</div><div class="value">${mv}</div></div>
            <div class="metric"><div class="label">Composite MPA</div><div class="value">${item.composite_mpa}</div></div>
            <div class="metric"><div class="label">Mean fidelity</div><div class="value">${item.mean_fidelity}</div></div>
            <div class="metric"><div class="label">Mean π_eff</div><div class="value">${item.mean_pi_eff}</div></div>
            <div class="metric"><div class="label">Total F</div><div class="value">${item.total_free_energy}</div></div>
          </div>
        </div>`;
      }).join("");
    } catch (err) {
      status.className = "error";
      status.textContent = "Error: " + (err.message || err);
    }
  }

  async function loadCollective() {
    const status = document.getElementById("collectiveStatus");
    const vNote = document.getElementById("versionNote");
    status.className = "muted";
    status.textContent = "Loading aggregate data…";
    try {
      aggregateData = await fetchJson(AGGREGATE_URL);
      status.style.display = "none";
      document.getElementById("collectiveControls").style.display = "grid";

      const versions = aggregateData.by_model_version || {};
      const active = aggregateData.active_model_version || "";
      const vParts = Object.keys(versions).map(v => v + " (n=" + versions[v] + ")");
      vNote.style.display = "block";
      vNote.innerHTML =
        "<strong>Model versions in aggregate:</strong> " +
        (vParts.length ? vParts.join(", ") : "none yet") +
        (active ? " · <strong>Current engine:</strong> " + active : "") +
        ". Prefer comparing runs that share the same model version after formula changes.";

      const groups = Object.keys(aggregateData.by_group || {});
      activeGroups = new Set(groups);
      const gEl = document.getElementById("groupToggles");
      gEl.innerHTML = groups.map(g =>
        `<button type="button" class="chip on" data-group="${g}" onclick="toggleGroup('${g}', this)">${g}</button>`
      ).join("") || "<span class='muted'>No group data yet</span>";

      const zEl = document.getElementById("zoneToggles");
      zEl.innerHTML = [1,2,3,4,5,6,7,8].map(z =>
        `<button type="button" class="chip on" data-zone="${z}" onclick="toggleZone(${z}, this)">Z${z}</button>`
      ).join("");

      renderCollective();
    } catch (err) {
      status.className = "error";
      status.textContent = "Error: " + (err.message || err);
    }
  }

  window.toggleGroup = function(g, btn) {
    if (activeGroups.has(g)) { activeGroups.delete(g); btn.classList.remove("on"); }
    else { activeGroups.add(g); btn.classList.add("on"); }
    renderCollective();
  };

  window.toggleZone = function(z, btn) {
    if (activeZones.has(z)) { activeZones.delete(z); btn.classList.remove("on"); }
    else { activeZones.add(z); btn.classList.add("on"); }
    renderCollective();
  };

  window.renderCollective = function renderCollective() {
    if (!aggregateData) return;
    const metric = document.getElementById("metricSelect").value;
    const overall = aggregateData.overall || {};
    document.getElementById("summaryCards").innerHTML = `
      <div class="summary-item"><div class="label">N submissions</div><div class="value">${overall.n || 0}</div></div>
      <div class="summary-item"><div class="label">Mean fidelity</div><div class="value">${overall.mean_fidelity ?? "—"}</div></div>
      <div class="summary-item"><div class="label">Mean π_eff</div><div class="value">${overall.mean_pi_eff ?? "—"}</div></div>
      <div class="summary-item"><div class="label">Mean total F</div><div class="value">${overall.mean_total_free_energy ?? "—"}</div></div>
    `;

    const zones = [1,2,3,4,5,6,7,8].filter(z => activeZones.has(z));
    const groups = [...activeGroups];
    const wrap = document.getElementById("radarWrap");
    const svg = document.getElementById("radarSvg");
    const legend = document.getElementById("radarLegend");

    if (!zones.length || !groups.length) {
      wrap.style.display = "none";
    } else {
      wrap.style.display = "block";
      const cx = 210, cy = 210, R = 150;
      const n = zones.length;
      let grid = "";
      for (let ring = 1; ring <= 4; ring++) {
        const r = (R * ring) / 4;
        let pts = [];
        for (let i = 0; i < n; i++) {
          const ang = -Math.PI / 2 + (2 * Math.PI * i) / n;
          pts.push((cx + r * Math.cos(ang)) + "," + (cy + r * Math.sin(ang)));
        }
        grid += `<polygon points="${pts.join(" ")}" fill="none" stroke="#e2e8f0" stroke-width="1"/>`;
      }
      let axes = "";
      let labels = "";
      zones.forEach((z, i) => {
        const ang = -Math.PI / 2 + (2 * Math.PI * i) / n;
        const x = cx + R * Math.cos(ang);
        const y = cy + R * Math.sin(ang);
        axes += `<line x1="${cx}" y1="${cy}" x2="${x}" y2="${y}" stroke="#e2e8f0"/>`;
        const lx = cx + (R + 22) * Math.cos(ang);
        const ly = cy + (R + 22) * Math.sin(ang);
        labels += `<text x="${lx}" y="${ly}" text-anchor="middle" dominant-baseline="middle" font-size="11" fill="#475569">Z${z}</text>`;
      });

      function norm(v) {
        if (v == null || isNaN(v)) return 0;
        if (metric === "mean_free_energy_F") return Math.max(0, Math.min(1, v / 3));
        if (metric === "mean_mpa_score") return Math.max(0, Math.min(1, v / 8));
        return Math.max(0, Math.min(1, v));
      }

      let polys = "";
      groups.forEach(g => {
        const gdata = aggregateData.by_group[g] || {};
        const byZone = gdata.by_zone || {};
        let pts = [];
        zones.forEach((z, i) => {
          const zd = byZone[String(z)] || byZone[z] || {};
          const val = norm(zd[metric]);
          const ang = -Math.PI / 2 + (2 * Math.PI * i) / n;
          const r = R * val;
          pts.push((cx + r * Math.cos(ang)) + "," + (cy + r * Math.sin(ang)));
        });
        const color = GROUP_COLORS[g] || "#0f766e";
        polys += `<polygon points="${pts.join(" ")}" fill="${color}33" stroke="${color}" stroke-width="2"/>`;
      });

      svg.innerHTML = grid + axes + polys + labels;
      legend.innerHTML = groups.map(g => {
        const color = GROUP_COLORS[g] || "#0f766e";
        return `<span><i class="swatch" style="background:${color}"></i>${g}</span>`;
      }).join("");
    }

    const regions = aggregateData.by_region || {};
    const rkeys = Object.keys(regions);
    if (!rkeys.length) {
      document.getElementById("regionTable").innerHTML = "";
      return;
    }
    document.getElementById("regionTable").innerHTML = `
      <h3 style="font-size:1rem;margin:1rem 0 0.5rem;color:#0f172a;">By world region</h3>
      <table class="region">
        <thead><tr><th>Region</th><th>N</th><th>Mean fidelity</th><th>Mean π_eff</th><th>Mean total F</th></tr></thead>
        <tbody>
          ${rkeys.map(r => {
            const row = regions[r];
            return `<tr>
              <td>${r}</td>
              <td>${row.n}</td>
              <td>${row.mean_fidelity}</td>
              <td>${row.mean_pi_eff}</td>
              <td>${row.mean_total_free_energy}</td>
            </tr>`;
          }).join("")}
        </tbody>
      </table>
      <p class="muted" style="padding:0.5rem 0;text-align:left;font-size:0.8rem;">
        Region aggregates are de-identified. Individual collaborator sources are not exposed.
      </p>
    `;
  };

  loadMine();
</script>
