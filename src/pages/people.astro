---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="People" description="People behind Rex Autistikōn Labs.">
  <section class="py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-8">People</h1>

      <div class="border border-slate-200 rounded-xl p-8 mb-10">
        <h2 class="text-xl font-semibold text-slate-900 mb-1">Hai Young Kim</h2>
        <p class="text-teal-700 font-medium mb-4">Founder & Independent Researcher</p>
        <p class="text-slate-600 leading-relaxed">
          Hai Young Kim leads the theoretical and computational work of Rex Autistikōn Labs. His research focuses on the biomechanics of sensory and interoceptive signaling, with particular attention to sensor-rich myofascial and visceral interfaces in neurodevelopmental conditions.
        </p>
      </div>

      <div class="border border-dashed border-slate-300 rounded-xl p-8 text-center">
        <p class="text-slate-500 mb-2">Collaborators & Advisors</p>
        <p class="text-sm text-slate-400">This section will expand as formal collaborations are established.</p>
      </div>
    </div>
  </section>
</BaseLayout>