---
import Layout from '../../layouts/BaseLayout.astro';
---

<Layout title="Admin · Collaborator Requests | Rex Autistikōn Labs">
  <main class="admin-page">
    <section class="hero">
      <h1>Collaborator Access Requests</h1>
      <p class="subtitle">
        Review and manage research partner applications.<br />
        Only authenticated foundation members should use this page.
      </p>
    </section>

    <section class="panel">
      <div class="toolbar">
        <button type="button" id="refreshBtn" class="btn-secondary" onclick="loadRequests()">Refresh Requests</button>
        <span id="status" class="status"></span>
      </div>
      <div id="list"></div>
    </section>
  </main>
</Layout>

<style>
  .admin-page { background: #f1f5f9; min-height: 80vh; }
  .hero {
    background: linear-gradient(135deg, #0f766e 0%, #134e4a 100%);
    color: #fff; text-align: center; padding: 2.75rem 1.25rem;
  }
  .hero h1 { font-size: 2rem; font-weight: 700; margin-bottom: 0.5rem; }
  .subtitle { max-width: 560px; margin: 0 auto; opacity: 0.92; line-height: 1.5; }

  .panel { max-width: 900px; margin: 0 auto; padding: 1.5rem 1.25rem 3rem; }
  .toolbar { display: flex; align-items: center; gap: 1rem; margin-bottom: 1rem; flex-wrap: wrap; }
  .btn-secondary {
    background: #fff; border: 1px solid #cbd5e1; color: #0f766e;
    font-weight: 600; padding: 0.5rem 1rem; border-radius: 8px; cursor: pointer;
  }
  .btn-secondary:hover { background: #f0fdfa; }
  .status { font-size: 0.9rem; color: #64748b; }
  .status.error { color: #b91c1c; }
  .status.success { color: #047857; }

  .card {
    background: #fff; border: 1px solid #e2e8f0; border-radius: 12px;
    padding: 1.15rem 1.25rem; margin-bottom: 0.85rem;
  }
  .card-head { display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; margin-bottom: 0.5rem; }
  .card h3 { margin: 0; font-size: 1.05rem; color: #0f172a; }
  .badge {
    font-size: 0.72rem; font-weight: 700; text-transform: uppercase;
    padding: 0.25rem 0.55rem; border-radius: 999px; letter-spacing: 0.03em;
  }
  .badge.pending { background: #fef3c7; color: #92400e; }
  .badge.approved { background: #d1fae5; color: #065f46; }
  .badge.denied { background: #fee2e2; color: #991b1b; }
  .meta { font-size: 0.85rem; color: #64748b; margin-bottom: 0.65rem; line-height: 1.45; }
  .intended {
    font-size: 0.9rem; color: #334155; background: #f8fafc;
    border-radius: 8px; padding: 0.65rem 0.75rem; margin-bottom: 0.85rem;
  }
  .actions { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .btn-approve {
    background: #0f766e; color: #fff; border: none; padding: 0.45rem 0.9rem;
    border-radius: 8px; font-weight: 600; cursor: pointer; font-size: 0.85rem;
  }
  .btn-deny {
    background: #fff; color: #b91c1c; border: 1px solid #fecaca; padding: 0.45rem 0.9rem;
    border-radius: 8px; font-weight: 600; cursor: pointer; font-size: 0.85rem;
  }
  .btn-approve:disabled, .btn-deny:disabled { opacity: 0.5; cursor: not-allowed; }
  .empty { text-align: center; color: #64748b; padding: 2rem; }
</style>

<script is:inline>
  const LIST_URL =
    "https://func-rex-calc-egaydydtenewdzf4.westus2-01.azurewebsites.net/api/list-requests?code=IbE0tv8ox0ux48tVZGZ3A8y3LlWyfP0SF2ONsty8Wk1iAzFuSZgiiQ==";
  const UPDATE_URL =
    "https://func-rex-calc-egaydydtenewdzf4.westus2-01.azurewebsites.net/api/update-request?code=C0FJKBRpVi3gVMLSi0S-YwO7kvBo6Ml3yd2V6msvs0r1AzFuUr2HGw==";

  async function fetchJson(url, options) {
    const res = await fetch(url, options || {});
    const text = await res.text();
    if (!text || !text.trim()) {
      throw new Error("HTTP " + res.status + " (empty response — bad Function key or CORS)");
    }
    let data;
    try {
      data = JSON.parse(text);
    } catch (e) {
      throw new Error("HTTP " + res.status + " — non-JSON: " + text.slice(0, 180));
    }
    if (!res.ok) {
      const msg = (data && (data.error || data.message)) || ("HTTP " + res.status);
      throw new Error(typeof msg === "string" ? msg : JSON.stringify(msg));
    }
    return data;
  }

  function badgeClass(status) {
    const s = (status || "pending").toLowerCase();
    if (s === "approved") return "badge approved";
    if (s === "denied") return "badge denied";
    return "badge pending";
  }

  function escapeHtml(s) {
    return String(s == null ? "" : s)
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;");
  }

  function escapeAttr(s) {
    return String(s == null ? "" : s).replace(/\\/g, "\\\\").replace(/'/g, "\\'");
  }

  window.loadRequests = async function loadRequests() {
    const status = document.getElementById("status");
    const list = document.getElementById("list");
    status.className = "status";
    status.textContent = "Loading…";
    try {
      const data = await fetchJson(LIST_URL);
      const items = data.items || [];
      status.textContent = items.length + " request(s)";
      if (!items.length) {
        list.innerHTML = '<p class="empty">No collaborator requests yet.</p>';
        return;
      }
      list.innerHTML = items.map(function (item) {
        var id = item.id;
        var st = item.status || "pending";
        var canAct = st === "pending";
        return (
          '<div class="card" data-id="' + escapeHtml(id) + '">' +
            '<div class="card-head">' +
              "<h3>" + escapeHtml(item.full_name || "—") + "</h3>" +
              '<span class="' + badgeClass(st) + '">' + escapeHtml(st) + "</span>" +
            "</div>" +
            '<div class="meta">' +
              "<div><strong>Email:</strong> " + escapeHtml(item.email || "") + "</div>" +
              "<div><strong>Organization:</strong> " + escapeHtml(item.organization || "") + "</div>" +
              "<div><strong>Role:</strong> " + escapeHtml(item.role || "") +
                (item.department ? " · " + escapeHtml(item.department) : "") + "</div>" +
              "<div><strong>IRB:</strong> " + escapeHtml(item.irb_status || "—") +
                " · <strong>Start:</strong> " + escapeHtml(item.start_date || "—") + "</div>" +
              "<div><strong>Submitted:</strong> " + escapeHtml(item.submitted_utc || "") + "</div>" +
              "<div><strong>ID:</strong> " + escapeHtml(id) + "</div>" +
            "</div>" +
            '<div class="intended"><strong>Intended use:</strong><br/>' +
              escapeHtml(item.intended_use || "") + "</div>" +
            '<div class="actions">' +
              '<button type="button" class="btn-approve"' + (canAct ? "" : " disabled") +
                " onclick=\"updateStatus('" + escapeAttr(id) + "','" + escapeAttr(item.email || "") + "','approved')\">Approve</button>" +
              '<button type="button" class="btn-deny"' + (canAct ? "" : " disabled") +
                " onclick=\"updateStatus('" + escapeAttr(id) + "','" + escapeAttr(item.email || "") + "','denied')\">Deny</button>" +
            "</div>" +
          "</div>"
        );
      }).join("");
    } catch (err) {
      status.className = "status error";
      status.textContent = "Error loading requests: " + (err && err.message ? err.message : String(err));
      list.innerHTML = "";
    }
  };

  window.updateStatus = async function updateStatus(id, email, newStatus) {
    var status = document.getElementById("status");
    status.className = "status";
    status.textContent = "Updating…";
    try {
      await fetchJson(UPDATE_URL, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ id: id, email: email, status: newStatus })
      });
      status.className = "status success";
      status.textContent = "Updated to " + newStatus;
      await loadRequests();
    } catch (err) {
      status.className = "status error";
      status.textContent = "Update failed: " + (err && err.message ? err.message : String(err));
    }
  };

  loadRequests();
</script>
