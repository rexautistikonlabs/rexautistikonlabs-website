---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Sponsors" description="Sponsors and partners of Rex Autistikōn Labs, a 501(c)(3) studying mechanobiology and afferent signaling.">
  <section class="py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-8">Sponsors & Partners</h1>

      <p class="text-lg text-slate-600 leading-relaxed mb-10">
        We are grateful for the support of individuals and organizations who believe in rigorous, open, mechanism-based research into neurodevelopmental conditions.
      </p>

      <ul class="flex flex-wrap justify-center gap-8 list-none m-0 p-0 mb-12">
        <li class="w-full max-w-sm border border-slate-200 rounded-xl bg-white px-8 py-10 text-center">
          <a
            href="https://www.sunfrog.com/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center"
          >
            <img
              src="/sponsors/sunfrog-logo.svg"
              alt="SunFrog"
              width="220"
              height="59"
              class="w-[220px] max-w-full h-auto"
            />
          </a>
          <p class="text-sm text-slate-600 mt-5 leading-relaxed">
            SunFrog — print-on-demand partner. Branded Foundation products in development.
          </p>
        </li>
      </ul>

      <div class="bg-slate-50 border border-slate-200 rounded-xl p-6">
        <h2 class="text-lg font-semibold text-slate-900 mb-2">Become a Sponsor</h2>
        <p class="text-slate-600 mb-4">
          We welcome partnerships with foundations, research groups, and individuals who share our commitment to open science and testable hypotheses.
        </p>
        <a href="/support" class="text-teal-700 font-medium hover:text-teal-800">
          Learn how to support the research →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>