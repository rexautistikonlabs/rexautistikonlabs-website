    padding: 0.95rem 1.05rem;
  }
  .phase h3 { margin: 0 0 0.35rem; font-size: 0.98rem; color: #0f766e; }
  .phase p { margin: 0; font-size: 0.92rem; }

  .pred-list { display: grid; gap: 0.75rem; margin: 1rem 0; }
  .pred {
    background: #fff; border: 1px solid #e2e8f0; border-radius: 10px;
    padding: 0.95rem 1.05rem;
  }
  .pred h3 { margin: 0 0 0.35rem; font-size: 0.98rem; color: #134e4a; }
  .pred p { margin: 0; font-size: 0.92rem; }

  .limits {
    display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin: 1rem 0;
  }
