    gap: 0.75rem; margin: 1rem 0;
  }
  .zone-card {
    display: flex; gap: 0.75rem; background: #fff; border: 1px solid #e2e8f0;
    border-radius: 10px; padding: 0.85rem 0.95rem;
  }
