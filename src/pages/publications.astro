---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Publications" description="Open-access publications from Rex Autistikōn Labs.">
  <section class="py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-8">Publications</h1>

      <p class="text-lg text-slate-600 leading-relaxed mb-12">
        All primary theoretical work from Rex Autistikōn Labs is published with open access. We prioritize transparent, citable dissemination of hypotheses, mathematical formalizations, and experimental protocols.
      </p>

      <div class="space-y-8">

        <!-- Primary Monograph -->
        <article class="border border-slate-200 rounded-xl p-6 bg-white">
          <div class="text-sm font-medium text-teal-700 mb-2">Primary Monograph · 2026</div>
          <h2 class="text-xl font-semibold text-slate-900 mb-3">
            Sensor-Rich Myofascial and Visceral Interfaces as Modulators of Afferent Signaling in Neurodevelopmental Conditions: A Biotensegrity-Informed Hypothesis
          </h2>
          <p class="text-slate-600 mb-4">
            Hai Young Kim · Rex Autistikon Research Foundation · Version 2.1
          </p>
          <a 
            href="https://doi.org/10.5281/zenodo.20737319" 
            target="_blank" 
            rel="noopener noreferrer"
            class="text-teal-700 font-medium hover:text-teal-800"
          >
            DOI: 10.5281/zenodo.20737319 →
          </a>
        </article>

        <!-- Collaborator Handbook -->
        <article class="border border-slate-200 rounded-xl p-6 bg-white">
          <div class="text-sm font-medium text-teal-700 mb-2">Pilot Study Collaborator Handbook · 2026</div>
          <h2 class="text-xl font-semibold text-slate-900 mb-3">
            Rex Autistikon Pilot Study Collaborator Handbook
          </h2>
          <p class="text-slate-600 mb-4">
            Practical guide for research collaborators, including sensor-rich zones, mechanistic layers, mathematical formalizations, and the MPA–Zone scoring system.
          </p>
          <a 
            href="https://zenodo.org/records/21536946" 
            target="_blank" 
            rel="noopener noreferrer"
            class="text-teal-700 font-medium hover:text-teal-800"
          >
            View on Zenodo →
          </a>
        </article>

        <!-- Placeholder for future papers -->
        <div class="border border-dashed border-slate-300 rounded-xl p-6 text-center">
          <p class="text-slate-500">Additional publications and preprints will appear here as they are released.</p>
        </div>

      </div>
    </div>
  </section>
</BaseLayout>