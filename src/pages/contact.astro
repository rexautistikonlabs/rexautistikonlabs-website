---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact"
  description="Contact Rex Autistikōn Labs, a 501(c)(3) mechanobiology foundation. Inquiries only. Not clinical intake."
>
  <section class="py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-4">Contact</h1>

      <p class="text-lg text-slate-600 leading-relaxed mb-4">
        Rex Autistikon Research Foundation, Inc. is an independent 501(c)(3) public charity.
        This form is for Foundation inquiries (research, collaboration, media, donations, and other).
        It is not clinical intake and not a collaborator-access request.
      </p>
      <p class="text-slate-600 leading-relaxed mb-10">
        For platform access, use{' '}
        <a href="/collaborate" class="text-teal-700 font-medium hover:text-teal-800">Request Access</a>.
      </p>

      <form
        id="contactForm"
        class="border border-slate-200 rounded-xl p-6 sm:p-8 mb-10 bg-white"
        action="/api/contact"
        method="POST"
      >
        <div class="grid sm:grid-cols-2 gap-5 mb-5">
          <div>
            <label for="name" class="block text-sm font-semibold text-slate-700 mb-1">Name <span class="text-red-700">*</span></label>
            <input id="name" name="name" type="text" required autocomplete="name" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-slate-900 focus:outline-none focus:border-teal-700 focus:ring-2 focus:ring-teal-700/20" />
          </div>
          <div>
            <label for="email" class="block text-sm font-semibold text-slate-700 mb-1">Institutional email <span class="text-red-700">*</span></label>
            <input id="email" name="email" type="email" required autocomplete="email" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-slate-900 focus:outline-none focus:border-teal-700 focus:ring-2 focus:ring-teal-700/20" />
          </div>
          <div>
            <label for="role" class="block text-sm font-semibold text-slate-700 mb-1">Role <span class="text-red-700">*</span></label>
            <input id="role" name="role" type="text" required autocomplete="organization-title" placeholder="e.g. researcher, journalist, donor" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-slate-900 focus:outline-none focus:border-teal-700 focus:ring-2 focus:ring-teal-700/20" />
          </div>
          <div>
            <label for="topic" class="block text-sm font-semibold text-slate-700 mb-1">Topic <span class="text-red-700">*</span></label>
            <select id="topic" name="topic" required class="w-full rounded-lg border border-slate-300 px-3 py-2 text-slate-900 bg-white focus:outline-none focus:border-teal-700 focus:ring-2 focus:ring-teal-700/20">
              <option value="">—</option>
              <option value="research">Research</option>
              <option value="collaboration">Collaboration</option>
              <option value="media">Media</option>
              <option value="donation">Donation</option>
              <option value="other">Other</option>
            </select>
          </div>
        </div>
        <div class="mb-5">
          <label for="message" class="block text-sm font-semibold text-slate-700 mb-1">Message <span class="text-red-700">*</span></label>
          <textarea id="message" name="message" rows="5" required class="w-full rounded-lg border border-slate-300 px-3 py-2 text-slate-900 focus:outline-none focus:border-teal-700 focus:ring-2 focus:ring-teal-700/20"></textarea>
        </div>
        <p class="text-sm text-slate-500 mb-5">
          By submitting, you agree that we may use these fields to respond to your inquiry, as described in the{' '}
          <a href="/privacy" class="text-teal-700 font-medium hover:text-teal-800">Privacy Policy</a>.
        </p>
        <p id="contactStatus" class="text-sm text-red-700 mb-4" role="alert" hidden></p>
        <button
          type="submit"
          id="contactSubmit"
          class="inline-flex items-center px-6 py-3 bg-teal-700 text-white font-medium rounded-lg hover:bg-teal-800 transition-colors disabled:opacity-60"
        >
          Send message
        </button>
      </form>
      <script is:inline>
        (function () {
          var form = document.getElementById('contactForm');
          var status = document.getElementById('contactStatus');
          var button = document.getElementById('contactSubmit');
          if (!form || !status || !button) return;

          // POST /api/contact is the Static Web App function. It forwards to
          // Logic App logic-rex-contact, which emails info@rexautistikonlabs.org.
          var endpoint = '/api/contact';
          var received = '/contact/received/';

          function showStatus(message, isError) {
            status.hidden = false;
            status.textContent = message;
            status.className = isError
              ? 'text-sm text-red-700 mb-4'
              : 'text-sm text-slate-600 mb-4';
          }

          form.addEventListener('invalid', function () {
            showStatus('Please complete all required fields.', true);
          }, true);

          form.addEventListener('submit', function (event) {
            event.preventDefault();
            if (!form.checkValidity()) {
              showStatus('Please complete all required fields.', true);
              return;
            }

            button.disabled = true;
            showStatus('Sending your message…', false);

            var payload = {
              name: document.getElementById('name').value.trim(),
              email: document.getElementById('email').value.trim(),
              role: document.getElementById('role').value.trim(),
              topic: document.getElementById('topic').value.trim(),
              message: document.getElementById('message').value.trim()
            };

            fetch(endpoint, {
              method: 'POST',
              headers: {
                Accept: 'application/json',
                'Content-Type': 'application/json'
              },
              body: JSON.stringify(payload)
            })
              .then(function (response) {
                return response.json().then(function (data) {
                  return { ok: response.ok, data: data };
                }).catch(function () {
                  return { ok: false, data: null };
                });
              })
              .then(function (result) {
                var message = result.data && result.data.message ? String(result.data.message) : '';
                var accepted = result.ok && result.data && result.data.success === true;
                if (accepted) {
                  window.location.assign(received);
                  return;
                }
                button.disabled = false;
                showStatus(message || 'The message could not be sent. Please email info@rexautistikonlabs.org directly.', true);
              })
              .catch(function () {
                button.disabled = false;
                showStatus('The form service did not respond. Please email info@rexautistikonlabs.org directly.', true);
              });
          });
        })();
      </script>

      <div class="bg-slate-50 border border-slate-200 rounded-xl p-8 mb-10">
        <h2 class="text-xl font-semibold text-slate-900 mb-4">Email</h2>
        <p class="text-lg text-slate-600">
          <a
            id="contact-email"
            href="mailto:info@rexautistikonlabs.org"
            data-analytics-event="contact_email_click"
            class="text-teal-700 hover:text-teal-800 font-medium"
          >
            info@rexautistikonlabs.org
          </a>
        </p>
      </div>

      <div class="bg-slate-50 border border-slate-200 rounded-xl p-8 mb-10">
        <h2 class="text-xl font-semibold text-slate-900 mb-4">Mailing Address</h2>
        <p class="text-lg text-slate-600 leading-relaxed">
          Rex Autistikon Research Foundation, Inc.<br />
          1485 Fouraker Rd #2402<br />
          Jacksonville, FL 32221<br />
          United States
        </p>
      </div>

      <p class="text-sm text-slate-500">
        We aim to respond to inquiries within a reasonable timeframe. The Foundation is not a clinic.
      </p>
    </div>
  </section>
</BaseLayout>
