---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact" description="Contact Rex Autistikōn Labs and the Rex Autistikon Research Foundation.">
  <section class="py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-8">Contact</h1>

      <p class="text-lg text-slate-600 leading-relaxed mb-10">
        For research collaboration inquiries, general questions, or media requests, please reach out using the information below.
      </p>

      <div class="bg-slate-50 border border-slate-200 rounded-xl p-8 mb-10">
        <h2 class="text-xl font-semibold text-slate-900 mb-4">Email</h2>
        <p class="text-lg text-slate-600">
          <a href="mailto:info@rexautistikonlabs.org" class="text-teal-700 hover:text-teal-800 font-medium">
            info@rexautistikonlabs.org
          </a>
        </p>
      </div>

      <div class="bg-slate-50 border border-slate-200 rounded-xl p-8 mb-10">
        <h2 class="text-xl font-semibold text-slate-900 mb-4">Mailing Address</h2>
        <p class="text-lg text-slate-600 leading-relaxed">
          Rex Autistikon Research Foundation, Inc.<br />
          1485 Fouraker Rd #2402<br />
          Jacksonville, FL 32221<br />
          United States
        </p>
      </div>

      <p class="text-sm text-slate-500">
        We aim to respond to inquiries within a reasonable timeframe. For collaboration proposals, please include a brief description of your interest and relevant background.
      </p>
    </div>
  </section>
</BaseLayout>