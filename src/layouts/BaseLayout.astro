---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  organizationSchema?: boolean;
  noindex?: boolean;
}

const {
  title = "Rex Autistikōn Labs",
  description = "Independent 501(c)(3) studying human mechanobiology and afferent signaling. Not a clinic.",
  organizationSchema = false,
  noindex = false,
} = Astro.props;

const siteName = "Rex Autistikōn Labs";
const siteUrl = "https://rexautistikonlabs.org";
const fullTitle =
  title === siteName || title.endsWith(` | ${siteName}`)
    ? title
    : `${title} | ${siteName}`;
const canonicalURL = new URL(Astro.url.pathname, siteUrl).href;

const organizationJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Rex Autistikon Research Foundation, Inc.",
  "alternateName": "Rex Autistikōn Labs",
  "url": "https://rexautistikonlabs.org",
  "logo": "https://rexautistikonlabs.org/logo.png",
  "email": "info@rexautistikonlabs.org",
  "taxID": "42-3220323",
  "nonprofitStatus": "Nonprofit501c3",
  "description": "Independent 501(c)(3) public charity. Rex Autistikōn Labs is its research initiative in human mechanobiology and afferent signaling. Not a clinic.",
  "sameAs": [
    "https://www.youtube.com/@RexAutistikon",
    "https://substack.com/@rexautistikonlabs"
  ],
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "1485 Fouraker Rd #2402",
    "addressLocality": "Jacksonville",
    "addressRegion": "FL",
    "postalCode": "32221",
    "addressCountry": "US"
  }
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-MS6WD4XB');</script>
    <!-- End Google Tag Manager -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary SEO -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={`${siteUrl}/logo.png`} />
    <meta property="og:image:alt" content={siteName} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}/logo.png`} />
    <meta name="twitter:image:alt" content={siteName} />

    <!-- Theme & Icons -->
    <meta name="theme-color" content="#0f766e" />
    <link rel="icon" type="image/png" href="/logo.png" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ResearchOrganization",
      "name": "Rex Autistikōn Labs",
      "alternateName": "Rex Autistikon Research Foundation, Inc.",
      "url": "https://rexautistikonlabs.org",
      "logo": "https://rexautistikonlabs.org/logo.png",
      "description": "Independent research into the biomechanics of sensory and interoceptive signaling in neurodevelopmental conditions.",
      "email": "info@rexautistikonlabs.org",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "1485 Fouraker Rd #2402",
        "addressLocality": "Jacksonville",
        "addressRegion": "FL",
        "postalCode": "32221",
        "addressCountry": "US"
      },
      "sameAs": [
        "https://www.youtube.com/@RexAutistikon",
        "https://substack.com/@rexautistikonlabs"
      ]
    })} />
    {organizationSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />
    )}
    <Analytics />
  </head>
  <body class="bg-white text-slate-800 font-sans antialiased">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MS6WD4XB" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>