---
const pathname = Astro.url.pathname;
---
<header class="site-header">
  <div class="header-inner">
    <a href="/" class="brand">
      <img src="/logo.png" alt="Rex Autistikōn Labs" class="brand-logo" width="44" height="44" />
      <span class="brand-text">
        <span class="brand-name">Rex Autistikōn Labs</span>
        <span class="brand-sub">Research Foundation</span>
      </span>
    </a>

    <nav class="nav" aria-label="Main">
      <a href="/" class:list={["nav-link", { active: pathname === "/" }]}>Home</a>
      <a href="/research" class:list={["nav-link", { active: pathname.startsWith("/research") && pathname === "/research" }]}>Research</a>
      <a href="/model" class:list={["nav-link", { active: pathname.startsWith("/model") }]}>Interactive Model</a>
      <a href="/publications" class:list={["nav-link", { active: pathname.startsWith("/publications") }]}>Publications</a>

      <div class="dropdown">
        <button type="button" class="nav-link dropdown-toggle" aria-expanded="false">More</button>
        <div class="dropdown-menu">
          <a href="/research-framework">Research Framework</a>
          <a href="/model-docs">Model Documentation</a>
          <a href="/collaborator-handbook">Collaborator Handbook</a>
          <a href="/education">Education</a>
          <a href="/people">People</a>
          <a href="/roadmap">Roadmap</a>
          <a href="/sponsors">Sponsors</a>
          <a href="/support">Support</a>
          <a href="/contact">Contact</a>
          <a href="/transparency">Transparency</a>
          <a href="/admin/collaborators">Admin</a>
        </div>
      </div>

      <div class="dropdown">
        <button type="button" class="nav-link dropdown-toggle" aria-expanded="false">Collaborator Portal</button>
        <div class="dropdown-menu">
          <a href="/how-to-collaborate">How to Collaborate</a>
          <a href="/collaborate">Request Access</a>
          <a href="/intake">Data Intake</a>
          <a href="/results">Results Dashboard</a>
        </div>
      </div>
    </nav>

    <div class="auth-actions">
      <a href="/.auth/login/aad" class="btn-sign-in">Sign in</a>
      <a href="/.auth/logout" class="btn-sign-out">Sign out</a>
    </div>
  </div>
</header>

<style>
  .site-header {
    background: #0b1220;
    color: #e2e8f0;
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid rgba(148, 163, 184, 0.15);
  }
  .header-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0.65rem 1.25rem;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    color: inherit;
    flex-shrink: 0;
  }
  .brand-logo {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
    background: #134e4a;
  }
  .brand-text { display: flex; flex-direction: column; line-height: 1.15; }
  .brand-name { font-weight: 700; font-size: 0.95rem; color: #f8fafc; }
  .brand-sub { font-size: 0.68rem; color: #94a3b8; }

  .nav {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    flex: 1;
    flex-wrap: wrap;
  }
  .nav-link {
    color: #cbd5e1;
    text-decoration: none;
    font-size: 0.88rem;
    font-weight: 500;
    padding: 0.4rem 0.65rem;
    border-radius: 6px;
    background: transparent;
    border: none;
    cursor: pointer;
    font-family: inherit;
  }
  .nav-link:hover, .nav-link.active { color: #fff; background: rgba(255,255,255,0.08); }

  .dropdown { position: relative; }
  .dropdown-menu {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 210px;
    background: #111827;
    border: 1px solid rgba(148,163,184,0.2);
    border-radius: 8px;
    padding: 0.4rem;
    box-shadow: 0 10px 30px rgba(0,0,0,0.35);
    z-index: 60;
  }
  .dropdown:hover .dropdown-menu,
  .dropdown:focus-within .dropdown-menu { display: block; }
  .dropdown-menu a {
    display: block;
    color: #e2e8f0;
    text-decoration: none;
    font-size: 0.85rem;
    padding: 0.5rem 0.7rem;
    border-radius: 6px;
  }
  .dropdown-menu a:hover { background: rgba(15,118,110,0.35); }

  .auth-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-left: auto;
  }
  .btn-sign-in {
    background: #0f766e;
    color: #fff;
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0.45rem 0.9rem;
    border-radius: 8px;
  }
  .btn-sign-in:hover { background: #0d9488; }
  .btn-sign-out {
    background: transparent;
    color: #cbd5e1;
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0.45rem 0.85rem;
    border-radius: 8px;
    border: 1px solid rgba(148,163,184,0.35);
  }
  .btn-sign-out:hover { color: #fff; border-color: #94a3b8; }

  @media (max-width: 900px) {
    .nav { width: 100%; order: 3; }
    .auth-actions { margin-left: 0; }
  }
</style>
